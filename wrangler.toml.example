name = "go-look-see-talleres"
compatibility_date = "2026-09-09"
pages_build_output_dir = "."

[vars]
ALLOWED_EMAIL_DOMAIN = "iberia.es"
ENVIRONMENT = "production"
MAIL_FROM = "Go, Look & See <REEMPLAZAR_CON_UN_REMITENTE_VERIFICADO>"
# Para Pages, el correo utiliza la API REST y estos valores se configuran como
# variables/secretos en el panel. No guardes el token en GitHub.
# CLOUDFLARE_ACCOUNT_ID = "REEMPLAZAR"
# CLOUDFLARE_EMAIL_API_TOKEN = "CONFIGURAR_COMO_SECRETO"

[[d1_databases]]
binding = "DB"
database_name = "go-look-see-talleres"
database_id = "REEMPLAZAR_CON_EL_ID_DE_TU_BASE_D1"
migrations_dir = "migrations"

# Opcional: no lo necesitas para el modo gratuito. Si algún día activas R2,
# descomenta este bloque y la aplicación lo utilizará automáticamente para
# las nuevas fotografías.
# [[r2_buckets]]
# binding = "PHOTOS"
# bucket_name = "go-look-see-talleres-photos"

# El binding [[send_email]] se reserva para un Worker independiente.
# Pages puede usar directamente CLOUDFLARE_EMAIL_API_TOKEN mediante la API REST.
